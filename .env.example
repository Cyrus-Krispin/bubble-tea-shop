# Local development only. Generate the ignored JWT_SECRET and JWT_KEYS values
# described in docs/development/local-docker.md before starting this stack.
POSTGRES_PASSWORD=local-supabase-postgres
JWT_EXPIRY=3600

# Local Supabase Auth JWT validation (no hosted project, keys, or tokens).
LOCAL_SUPABASE_AUTH_ENABLED=true
LOCAL_SUPABASE_AUTH_ISSUER_URI=http://localhost:8000/auth/v1
LOCAL_SUPABASE_AUTH_JWK_SET_URI=http://kong:8000/auth/v1/.well-known/jwks.json
LOCAL_SUPABASE_AUTH_AUDIENCE=authenticated

POSTGRES_PORT=54322
KONG_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=4173
API_BASE_URL=http://localhost:8080

# Production tracing is opt-in. Point this at an OTLP/HTTP collector before enabling it.
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=0.1
